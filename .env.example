# =============================================================================
# MS Ordenes
# =============================================================================

# Puerto HTTP del microservicio de ordenes
PORT=3000

# Clave de autenticacion para el guard de API Key
# Cambiar obligatoriamente en produccion
API_KEY=local-dev-key

# Conexion a PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=orders_db
DB_USER=postgres
DB_PASSWORD=postgres

# Conexion al microservicio de auditoria via TCP
# En docker-compose usar el nombre del servicio: audit-service
# En local usar: localhost
AUDIT_HOST=audit-service
AUDIT_TCP_PORT=4001

# =============================================================================
# MS Auditoria
# =============================================================================

# Puerto HTTP del microservicio de auditoria
HTTP_PORT=3001

# Puerto TCP para recibir eventos del MS Ordenes
AUDIT_TCP_PORT=4001

# Cadena de conexion a MongoDB
# En docker-compose usar el nombre del servicio: mongo
# En local usar: localhost
MONGODB_URI=mongodb://mongo:27017/audit_db
