  "item": [
    {
      "name": "01 - Catalog",
      "item": [
        {
          "name": "GET /catalog/products - success",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "url": {
              "raw": "{{ordersBaseUrl}}/catalog/products",
              "host": ["{{ordersBaseUrl}}"],
              "path": ["catalog", "products"]
            },
            "description": "Obtiene el catalogo mock disponible desde la API."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('retorna array de productos', function () { pm.expect(Array.isArray(body)).to.eql(true); pm.expect(body.length).to.be.above(0); });",
                  "const active = body.find(product => product.active && product.availableStock > 0);",
                  "const second = body.find(product => product.productId !== active.productId && product.active && product.availableStock > 0);",
                  "const noStock = body.find(product => product.availableStock === 0);",
                  "const inactive = body.find(product => product.active === false);",
                  "if (active) { pm.collectionVariables.set('catalogActiveSku', active.productId); }",
                  "if (second) { pm.collectionVariables.set('catalogSecondSku', second.productId); }",
                  "if (noStock) { pm.collectionVariables.set('catalogNoStockSku', noStock.productId); }",
                  "if (inactive) { pm.collectionVariables.set('catalogInactiveSku', inactive.productId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /catalog/products - missing API key",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ordersBaseUrl}}/catalog/products",
              "host": ["{{ordersBaseUrl}}"],
              "path": ["catalog", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('mensaje de API key requerida', function () { pm.expect(pm.response.json().message).to.eql('API key is required'); });"
                ]
              }
            }
          ]
        },
